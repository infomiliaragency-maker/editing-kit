# Chiavi degli strumenti. Copia questo file in .env e incolla le chiavi dopo l'uguale, senza spazi né virgolette.
# .env non va mai condiviso né caricato su GitHub.

# fal.ai, obbligatoria: trascrizioni, b-roll generati, musica, voiceover. https://fal.ai/dashboard/keys
FAL_KEY=

# Google AI Studio, facoltativa: solo per il voiceover con il motore gemini-38. https://aistudio.google.com/apikey
GEMINI_API_KEY=
